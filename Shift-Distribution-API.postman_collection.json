{
  "info": {
    "name": "Shift Distribution API",
    "description": "Laravel API for the Shift Distribution System (phase 1 backend). Run 'Login' first — it stores the bearer token in the {{token}} collection variable automatically, and every other request uses it. 'Create' requests likewise auto-capture ids (worker_id, client_id, shift_id, assignment_id) into collection variables so the rest of the collection can be run top-to-bottom with Postman's Collection Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000/api", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "worker_id", "value": "", "type": "string" },
    { "key": "client_id", "value": "", "type": "string" },
    { "key": "shift_id", "value": "", "type": "string" },
    { "key": "assignment_id", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/login", "host": ["{{base_url}}"], "path": ["login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"dispatcher@example.com\",\n  \"password\": \"password\"\n}"
            },
            "description": "Seeded logins (see README): admin@example.com / dispatcher@example.com / viewer@example.com, all password \"password\"."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) { pm.collectionVariables.set('token', json.token); }",
                  "pm.test('login succeeded', () => pm.response.code === 200);"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/logout", "host": ["{{base_url}}"], "path": ["logout"] }
          }
        },
        {
          "name": "Current User",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/user", "host": ["{{base_url}}"], "path": ["user"] }
          }
        }
      ]
    },
    {
      "name": "Workers",
      "item": [
        {
          "name": "List Workers",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/workers", "host": ["{{base_url}}"], "path": ["workers"] }
          }
        },
        {
          "name": "Create Worker",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/workers", "host": ["{{base_url}}"], "path": ["workers"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Jane\",\n  \"last_name\": \"Doe\",\n  \"email\": \"jane.doe@example.com\",\n  \"gender\": \"female\",\n  \"contracted_weekly_hours\": 20,\n  \"standby\": false,\n  \"journey_preference\": \"any\",\n  \"is_active\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.id) { pm.collectionVariables.set('worker_id', json.data.id); }",
                  "pm.test('worker created', () => pm.response.code === 201);"
                ]
              }
            }
          ]
        },
        {
          "name": "Show Worker",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/workers/{{worker_id}}", "host": ["{{base_url}}"], "path": ["workers", "{{worker_id}}"] }
          }
        },
        {
          "name": "Update Worker",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/workers/{{worker_id}}", "host": ["{{base_url}}"], "path": ["workers", "{{worker_id}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"standby\": true\n}" }
          }
        },
        {
          "name": "Delete Worker",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/workers/{{worker_id}}", "host": ["{{base_url}}"], "path": ["workers", "{{worker_id}}"] }
          }
        }
      ]
    },
    {
      "name": "Clients",
      "item": [
        {
          "name": "List Clients",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/clients", "host": ["{{base_url}}"], "path": ["clients"] }
          }
        },
        {
          "name": "Create Client",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/clients", "host": ["{{base_url}}"], "path": ["clients"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Acme Care\",\n  \"contact_name\": \"Alex Contact\",\n  \"contact_email\": \"alex@acmecare.example\",\n  \"is_active\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.id) { pm.collectionVariables.set('client_id', json.data.id); }",
                  "pm.test('client created', () => pm.response.code === 201);"
                ]
              }
            }
          ]
        },
        {
          "name": "Show Client",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/clients/{{client_id}}", "host": ["{{base_url}}"], "path": ["clients", "{{client_id}}"] }
          }
        },
        {
          "name": "Update Client",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/clients/{{client_id}}", "host": ["{{base_url}}"], "path": ["clients", "{{client_id}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"contact_name\": \"Updated Contact\"\n}" }
          }
        },
        {
          "name": "Delete Client",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/clients/{{client_id}}", "host": ["{{base_url}}"], "path": ["clients", "{{client_id}}"] }
          }
        }
      ]
    },
    {
      "name": "Shifts",
      "item": [
        {
          "name": "List Shifts",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/shifts", "host": ["{{base_url}}"], "path": ["shifts"] }
          }
        },
        {
          "name": "Create Shift",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/shifts", "host": ["{{base_url}}"], "path": ["shifts"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_id\": \"{{client_id}}\",\n  \"pickup_address_text\": \"12 High Street\",\n  \"destination_address_text\": \"Willow Day Centre\",\n  \"shift_date\": \"2026-09-01\",\n  \"start_time\": \"09:00\",\n  \"end_time\": \"11:00\",\n  \"gender_requirement\": \"any\"\n}"
            },
            "description": "Run 'Create Client' first so {{client_id}} is populated."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.id) { pm.collectionVariables.set('shift_id', json.data.id); }",
                  "pm.test('shift created', () => pm.response.code === 201);"
                ]
              }
            }
          ]
        },
        {
          "name": "Show Shift",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/shifts/{{shift_id}}", "host": ["{{base_url}}"], "path": ["shifts", "{{shift_id}}"] }
          }
        },
        {
          "name": "Update Shift",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/shifts/{{shift_id}}", "host": ["{{base_url}}"], "path": ["shifts", "{{shift_id}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"pending\"\n}" }
          }
        },
        {
          "name": "Delete Shift",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/shifts/{{shift_id}}", "host": ["{{base_url}}"], "path": ["shifts", "{{shift_id}}"] }
          }
        }
      ]
    },
    {
      "name": "Shift Messages",
      "item": [
        {
          "name": "Ingest Message",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/shift-messages", "host": ["{{base_url}}"], "path": ["shift-messages"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channel\": \"manual\",\n  \"raw_message\": \"Need a driver for Acme Care on 12/09/2026 from 09:00 to 11:00, pickup 12 High Street, dropoff Willow Day Centre. Female driver required.\",\n  \"sender_identifier\": \"dispatcher@example.com\"\n}"
            },
            "description": "Parsed synchronously by MockAIParser (QUEUE_CONNECTION=sync). The response reflects the parse result immediately — parse_status will be 'validated' or 'failed', and shift_id is set if the parsed client name matched an existing Client exactly (try 'Acme Care' after running Create Client)."
          }
        }
      ]
    },
    {
      "name": "Allocation",
      "item": [
        {
          "name": "Run Allocation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/allocation/run", "host": ["{{base_url}}"], "path": ["allocation", "run"] },
            "body": { "mode": "raw", "raw": "{\n  \"shift_id\": \"{{shift_id}}\"\n}" },
            "description": "Scores every eligible worker against the shift and proposes the top-ranked one as a new Assignment. Run 'Create Shift' first."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.proposed_assignment && json.proposed_assignment.id) {",
                  "  pm.collectionVariables.set('assignment_id', json.proposed_assignment.id);",
                  "}",
                  "pm.test('allocation ran', () => pm.response.code === 200);"
                ]
              }
            }
          ]
        },
        {
          "name": "Allocation History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/allocation/history?shift_id={{shift_id}}",
              "host": ["{{base_url}}"],
              "path": ["allocation", "history"],
              "query": [{ "key": "shift_id", "value": "{{shift_id}}", "description": "Optional — also accepts from/to date filters" }]
            }
          }
        }
      ]
    },
    {
      "name": "Assignments",
      "item": [
        {
          "name": "Confirm Assignment",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/assignments/{{assignment_id}}/confirm",
              "host": ["{{base_url}}"],
              "path": ["assignments", "{{assignment_id}}", "confirm"]
            },
            "description": "Run 'Run Allocation' first so {{assignment_id}} is populated."
          }
        },
        {
          "name": "Cancel Assignment",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/assignments/{{assignment_id}}/cancel",
              "host": ["{{base_url}}"],
              "path": ["assignments", "{{assignment_id}}", "cancel"]
            },
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Worker unavailable\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Hours Report",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/reports/hours",
              "host": ["{{base_url}}"],
              "path": ["reports", "hours"],
              "query": [{ "key": "week", "value": "2026-09-01", "description": "Optional — any date in the target ISO week", "disabled": true }]
            }
          }
        },
        {
          "name": "Workers Report",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/reports/workers", "host": ["{{base_url}}"], "path": ["reports", "workers"] }
          }
        },
        {
          "name": "Shifts Report",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/reports/shifts",
              "host": ["{{base_url}}"],
              "path": ["reports", "shifts"],
              "query": [
                { "key": "from", "value": "2026-08-01", "disabled": true },
                { "key": "to", "value": "2026-09-30", "disabled": true }
              ]
            }
          }
        }
      ]
    }
  ]
}
